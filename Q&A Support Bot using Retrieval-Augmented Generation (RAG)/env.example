# ---------------------------------------------------------------------------
# Copy this file to .env and edit if you want to override a default.
#
#   Windows:  copy env.example .env
#   macOS:    cp env.example .env
#
# Every value below already has a working default in app/config.py, so the
# project runs with NO .env file at all. Nothing here is a secret, because
# this stack does not use a paid API key.
# ---------------------------------------------------------------------------

# --- Local LLM (Ollama) ----------------------------------------------------
# Pull the model first:  ollama pull llama3.1
# On a machine with 8 GB RAM, use a smaller model instead: llama3.2:3b
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120

# --- Local LLM performance -------------------------------------------------
# These three decide whether an answer takes 2 seconds or a minute, and they
# matter most on a machine where Ollama reports "100% CPU" in `ollama ps`.
#
# How long Ollama keeps the weights in memory after a request. Ollama's own
# default is 5m, which means a user who reads an answer and then asks a follow
# up pays the full model load again. Use -1 to pin the model indefinitely.
LLM_KEEP_ALIVE=30m
# Context window. Ollama was allocating 32768 tokens of KV cache for llama3.1;
# this bot's prompt never exceeds ~2k, and the cache costs RAM and CPU time on
# every request. Raise it only if you raise RETRIEVAL_K or CHUNK_SIZE a lot.
LLM_NUM_CTX=4096
# Hard cap on answer length in tokens. Unbounded generation is the largest
# latency term on CPU.
LLM_NUM_PREDICT=384

# Load the embedding model and pin the LLM at startup, in a background thread,
# instead of on the first question. Set false if you want the process to start
# without touching either model.
WARMUP_ON_STARTUP=true

# --- Local embeddings ------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ----------------------------------------------------------
CHROMA_DIR=chroma_db
COLLECTION_NAME=support_documents

# --- Retrieval tuning ------------------------------------------------------
# Raised from 3 after measurement: the answer to "I was charged twice for my
# order" sat fourth at 0.352, above the threshold but outside the window.
RETRIEVAL_K=5
# Cosine relevance in [0, 1]. Chunks scoring below this are discarded and the
# bot answers "not enough information" instead of guessing. MEASURE this
# against your own documents rather than trusting the default.
RELEVANCE_THRESHOLD=0.35

# --- Ingestion -------------------------------------------------------------
DOCUMENTS_DIR=data/documents
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Domain ----------------------------------------------------------------
# The only three strings in the shipped answers that know what this bot is for.
# Change these plus DOCUMENTS_DIR to point the same code at a different domain -
# banking, HR, insurance, internal IT. Nothing else in app/ is domain-aware.
#
# What does NOT carry over: evaluation/datasets/*.json all assert e-commerce
# facts, and RELEVANCE_THRESHOLD was measured against this corpus. A new domain
# needs new datasets and a re-run of `python -m evaluation.calibrate`.
ASSISTANT_ROLE=a helpful customer support assistant
ESCALATION_HINT=Please contact a support agent for help with this question.
KNOWLEDGE_DOMAIN=the support documentation

# A banking deployment, for example:
# ASSISTANT_ROLE=a retail banking assistant
# ESCALATION_HINT=Please call the number printed on your statement.
# KNOWLEDGE_DOMAIN=the banking product documentation
# DOCUMENTS_DIR=data/banking
# CHROMA_DIR=chroma_banking
# COLLECTION_NAME=banking_documents
